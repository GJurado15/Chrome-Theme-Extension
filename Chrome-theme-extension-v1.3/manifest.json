{
  "manifest_version": 3,
  "name": "Theme Generator",
  "icons": {
    "128": "icons/icon128.png"
  },
  "version": "2.0",
  "description": "Create, preview, and download custom Chrome themes.",
  "action": {
    "default_title": "Create Theme"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "downloads",
    "storage"
  ]
}